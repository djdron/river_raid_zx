	db $0D,$E9,$01	; bit 0
	db $3B,$D2,$01	; bit 1
	db $57,$A4,$01	; bit 2
	db $8F,$48,$01	; bit 3
	db $3F,$91,$00	; bit 4
	db $7E,$22,$01	; bit 5
	db $DD,$44,$00	; bit 6
	db $BA,$89,$00	; bit 7
	db $74,$13,$01	; bit 8
	db $C9,$26,$00	; bit 9
	db $92,$4D,$00	; bit 10
	db $24,$9B,$00	; bit 11
	db $48,$36,$01	; bit 12
	db $B1,$6C,$00	; bit 13
	db $62,$D9,$00	; bit 14
	db $C4,$B2,$01	; bit 15
	db $A9,$65,$01	; bit 16
